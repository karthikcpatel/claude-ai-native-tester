{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.85",
        "--isolated",
        "--allowed-origins",
        "http://localhost:8000;http://127.0.0.1:8000",
        "--output-dir",
        "reports/mcp"
      ],
      "env": {}
    }
  }
}
